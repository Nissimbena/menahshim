rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'nissim@letscoach.net';
    }

    // Basic user profile, created on first sign-in.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // A user's prediction for a specific game. Document id: "{uid}_{gameId}".
    match /predictions/{predictionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && predictionId == request.auth.uid + '_' + request.resource.data.gameId;
      allow delete: if false;
    }

    // Actual game results - only the admin account can write these.
    match /gameResults/{gameId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
